<IfModule mod_rewrite.c>
  RewriteEngine On
  # Keep old extensionless API URLs working on Apache/PHP.
  RewriteRule ^api/(pdf|manualpdf|pdfbraille|supabase-config)$ api/$1.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
